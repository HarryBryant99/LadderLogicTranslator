<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:pro="https://sigrad.siemens.cloud/SafetyPropSchema" 
            xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
            targetNamespace="https://sigrad.siemens.cloud/SafetyPropSchema" 
            elementFormDefault="qualified" >
    <xsd:element name="AbstractFirstOrderFormula" abstract="true" />
    <xsd:element name="Predicate" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:PredicateType"></xsd:element>
    <xsd:element name="And" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:BinaryOperatorType"></xsd:element>
    <xsd:element name="Negation" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:UnaryOperatorType"></xsd:element>
    <xsd:element name="Brackets" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:UnaryOperatorType"></xsd:element>
    <xsd:element name="Or" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:BinaryOperatorType"></xsd:element>
    <xsd:element name="Implies" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:BinaryOperatorType"></xsd:element>
    <xsd:element name="Forall" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:QuatifierType"></xsd:element>
    <xsd:element name="Exists" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:QuatifierType"></xsd:element>
    <xsd:element name="Equivalent" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:BinaryOperatorType"></xsd:element>
    <xsd:element name="Equality" substitutionGroup="pro:AbstractFirstOrderFormula" type="pro:EqualityOperatorType"></xsd:element>
    
    <xsd:complexType name="EqualityOperatorType">
        <xsd:sequence minOccurs="1" maxOccurs="1">
            <xsd:element ref="pro:Term"></xsd:element>
            <xsd:element ref="pro:Term"></xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    
    <xsd:complexType name="BinaryOperatorType">
        <xsd:sequence minOccurs="1" maxOccurs="1">
            <xsd:element ref="pro:AbstractFirstOrderFormula"></xsd:element>
            <xsd:element ref="pro:AbstractFirstOrderFormula"></xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="UnaryOperatorType">
        <xsd:sequence>
            <xsd:element ref="pro:AbstractFirstOrderFormula" maxOccurs="1" minOccurs="1"></xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="QuatifierType">
        <xsd:sequence maxOccurs="1" minOccurs="1">
            <xsd:element name="Var" type="xsd:string"></xsd:element>
            <xsd:element name="Type" type="xsd:string"></xsd:element>
            <xsd:element ref="pro:AbstractFirstOrderFormula"></xsd:element>
        </xsd:sequence>
        <xsd:attribute name="blockInstantiation" type="xsd:boolean" default="false"> </xsd:attribute>
    </xsd:complexType>
    
    
    <xsd:element name="Term" type="pro:TermType"></xsd:element>

    <xsd:complexType name="TermType">
        <xsd:choice>
            <xsd:element name="Var" type="xsd:string"></xsd:element>
            <xsd:element name="NamedConstant" type="xsd:string"></xsd:element>
            <xsd:element ref="pro:LiteralConstant"></xsd:element>
            <xsd:element ref="pro:Function"></xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:complexType name="PredicateType">
        <xsd:sequence minOccurs="1" maxOccurs="unbounded">
            <xsd:element ref="pro:Term"></xsd:element>
        </xsd:sequence>
        <xsd:attribute name="name" type="xsd:string" use="required"></xsd:attribute>
    </xsd:complexType>

    <xsd:element name="Property" type="pro:PropertyType"></xsd:element>

    <xsd:complexType name="PropertyType">
        <xsd:sequence minOccurs="1" maxOccurs="1">
            <xsd:element name="Description" type="xsd:string"></xsd:element>
            <xsd:element ref="pro:AbstractFirstOrderFormula"></xsd:element>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:string" use="required"></xsd:attribute>
    </xsd:complexType>

    <xsd:element name="Function" type="pro:FunctionType"></xsd:element>

    <xsd:complexType name="FunctionType">
        <xsd:sequence minOccurs="0" maxOccurs="unbounded">
            <xsd:element ref="pro:Term"></xsd:element>
        </xsd:sequence>
        <xsd:attribute name="name" type="xsd:string" use="required"></xsd:attribute>
    </xsd:complexType>

    <xsd:element name="LiteralConstant" type="pro:LiteralConstantType"></xsd:element>
    <xsd:complexType name="LiteralConstantType">
        <xsd:sequence minOccurs="1" maxOccurs="1">
            <xsd:element name= "Value" type="xsd:string"></xsd:element>
            <xsd:element name= "Type" type="xsd:string"></xsd:element>
        </xsd:sequence>
    </xsd:complexType>

</xsd:schema>
